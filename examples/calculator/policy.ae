// Deliberately restricted endpoint grammar until std.url exports whole-URL parsing.
// HTTPS remotely; explicit plain HTTP only for localhost/127.0.0.1 testing.
import std.string
import std.strbuilder

exports(endpoint, preflight, loopback, purpose, approval_prompt, module_url, module_requested, module_prompt)

module_url(calculator: string, reference: string) -> (string, string) {
    _host, _port, err = endpoint(calculator)
    if err != "" { return "", err }
    if reference != "/static/calculator.rexx" { return "", "only the exact /static/calculator.rexx import is supported" }
    return "${string.substring(calculator, 0, string.length(calculator) - 10)}${reference}", ""
}

module_requested(source: string) -> bool {
    return string.contains(source, "/* @seeks http.get /static/calculator.rexx */") == 1
}

loopback(host: string) -> bool { return host == "localhost" || host == "127.0.0.1" }

endpoint(url: string) -> (string, int, string) {
    secure = string.starts_with(url, "https://") == 1
    local_http = string.starts_with(url, "http://") == 1
    if string.length(url) > 300 || (!secure && !local_http) || string.ends_with(url, "/calculate") != 1 {
        return "", 0, "endpoint must be https://host:port/calculate (or http://localhost:port/calculate for local testing)"
    }
    start = 8
    if local_http { start = 7 }
    authority = string.substring(url, start, string.length(url) - 10)
    colon = string.index_of(authority, ":")
    if colon <= 0 { return "", 0, "explicit endpoint port required" }
    host = string.substring(authority, 0, colon)
    if host != string.to_lower(host) || string.length(host) > 253 { return "", 0, "noncanonical host" }
    i = 0
    label = 0
    last = 0
    while i < string.length(host) {
        c = string.char_at(host, i)
        if c == 46 {
            if label == 0 || last == 45 { return "", 0, "invalid host label" }
            label = 0
        } else {
            if !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || (c == 45 && label > 0)) {
                return "", 0, "invalid host"
            }
            label = label + 1
            if label > 63 { return "", 0, "host label too long" }
        }
        last = c
        i = i + 1
    }
    if label == 0 || last == 45 { return "", 0, "invalid host label" }
    if local_http && !loopback(host) { return "", 0, "plain HTTP is restricted to localhost or 127.0.0.1" }
    port_text = string.substring(authority, colon + 1, string.length(authority))
    if string.length(port_text) == 0 || string.length(port_text) > 5 || string.char_at(port_text, 0) == 48 {
        return "", 0, "invalid port"
    }
    for j in 0..string.length(port_text) {
        c = string.char_at(port_text, j)
        if c < 48 || c > 57 { return "", 0, "invalid port" }
    }
    port, err = string.to_int(port_text)
    if err != "" || port < 1 || port > 65535 { return "", 0, "invalid port" }
    return host, port, ""
}

preflight(source: string, approved: string) -> string {
    _host, _port, err = endpoint(approved)
    if err != "" { return err }
    end = string.index_of(source, "\n")
    if end < 0 { end = string.length(source) }
    first = string.trim(string.substring(source, 0, end))
    if first != "/* @seeks http.post ${approved} */" {
        return "first line must declare the exact host-approved calculator endpoint"
    }
    // A second, separate GET request can authorize the relative module import.
    // Declarations must precede code; unknown, duplicate or late asks fail closed.
    rest = string.substring(source, end, string.length(source))
    lines = string.split(rest, "\n")
    defer string.array_free(lines)
    code = false
    get_seen = false
    for i in 0..string.array_size(lines) {
        line = string.trim(string.array_get(lines, i))
        if string.contains(line, "@seeks") == 1 {
            if code || get_seen || line != "/* @seeks http.get /static/calculator.rexx */" {
                return "unsupported, duplicate or late capability declaration"
            }
            get_seen = true
        }
        if line != "" && !(string.starts_with(line, "/*") == 1 && string.ends_with(line, "*/") == 1) { code = true }
    }
    _claimed, purpose_error = purpose(source)
    if purpose_error != "" { return purpose_error }
    return ""
}

// Optional untrusted metadata immediately after the endpoint declaration.
purpose(source: string) -> (string, string) {
    first_end = string.index_of(source, "\n")
    if first_end < 0 { return "(not supplied)", "" }
    rest = string.substring(source, first_end + 1, string.length(source))
    end = string.index_of(rest, "\n")
    if end < 0 { end = string.length(rest) }
    line = string.trim(string.substring(rest, 0, end))
    if string.starts_with(line, "/* @purpose") != 1 { return "(not supplied)", "" }
    if string.starts_with(line, "/* @purpose ") != 1 || string.ends_with(line, " */") != 1 {
        return "", "purpose must be a single /* @purpose text */ comment on line two"
    }
    text = string.substring(line, 12, string.length(line) - 3)
    if string.length(text) == 0 || string.length(text) > 240 || string.contains(text, "*/") == 1 {
        return "", "self-claimed purpose must be 1..240 bytes without a comment terminator"
    }
    return text, ""
}

// Never print untrusted terminal controls, bidi bytes, quotes or backslashes
// verbatim in an approval prompt. All metadata is visibly quoted ASCII.
display(text: string) -> string {
    out = strbuilder.new(64)
    strbuilder.append(out, "\"")
    limit = string.length(text)
    if limit > 512 { limit = 512 }
    digits = "0123456789abcdef"
    for i in 0..limit {
        c = string.char_at(text, i)
        if c >= 32 && c <= 126 && c != 34 && c != 92 {
            strbuilder.append(out, string.substring(text, i, i + 1))
        } else {
            hi = (c & 255) / 16
            lo = c & 15
            strbuilder.append(out, "\\x${string.substring(digits, hi, hi + 1)}${string.substring(digits, lo, lo + 1)}")
        }
    }
    if string.length(text) > limit { strbuilder.append(out, " (truncated)") }
    strbuilder.append(out, "\"")
    return strbuilder.finish(out)
}

approval_prompt(source: string, url: string, program: string) -> (string, string) {
    err = preflight(source, url)
    if err != "" { return "", err }
    host, port, _endpoint_error = endpoint(url)
    claimed, _purpose_error = purpose(source)
    return "${display(program)} requests:\n  HTTP POST ${url}\n\nSelf-claimed purpose (unverified):\n  ${display(claimed)}\n\nDestination hostname: ${host}\nPort: ${port}\nPath: /calculate\nApproval covers only this exact scheme, operation, hostname, port and path.\nNo trust is inherited from a parent domain or sibling subdomains.\n\nAllow for this session? [y/N] ", ""
}

module_prompt(source: string, calculator: string, program: string) -> (string, string) {
    err = preflight(source, calculator)
    if err != "" { return "", err }
    if !module_requested(source) { return "", "module GET capability was not requested" }
    url, _url_error = module_url(calculator, "/static/calculator.rexx")
    host, port, _endpoint_error = endpoint(calculator)
    claimed, _purpose_error = purpose(source)
    return "${display(program)} requests:\n  HTTP GET ${url}\n  Download Rexx code; CALC will execute this downloaded module.\n\nSelf-claimed purpose (unverified):\n  ${display(claimed)}\n\nDestination hostname: ${host}\nPort: ${port}\nPath: /static/calculator.rexx\nApproval covers only this exact scheme, operation, hostname, port and path.\nNo trust is inherited from a parent domain or sibling subdomains.\n\nAllow for this session? [y/N] ", ""
}
