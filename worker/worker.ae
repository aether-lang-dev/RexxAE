// rexxae-worker: runs one Rexx script for a host in another process.
//
// The host starts this program with std.guest (guest.launch, through
// sandbox.spawn_socket) and talks to it over the socket in frames. The
// protocol, and everything about it on this side (the mounts and the
// script, the lockdown, the PROBE self-check, CANCEL, LOGLEVEL, a file
// handed over as a descriptor), is Aether's std.guest.child; its README
// (std/guest/README.md) has every message. What is here is the engine glue:
// how a Rexx script runs, in steps, and what each step's event becomes.
// The engine is compiled in from source, so the worker is one binary:
// under the process sandbox it needs no grants at all.
//
// Three walls. The engine's own: it has no system API, every effect is an
// event this worker answers, and it mounts no ADDRESS environment. This
// worker's: child.run enters sandbox.enforce with no grants before the
// script's first step, so even a bug in the engine is held to nothing. And
// the process's, the sandbox the host spawned it in, which also holds code
// that goes round std and libc.
//
// It answers a CANCEL at any point after SCRIPT with rexxae_cancel: between
// steps of BUDGET instructions (child.poll) or instead of a reply to a call
// (child.call_host), so a script that loops forever or waits forever on the
// host stops within one step.
//
// EXPORT('label') (the worker's own function) names a label for the host to
// call once the script has ended. A script that exported labels and ended
// with EXIT 0 (or by running off its end) sends READY and the names instead
// of DONE, and serves: each INVOKE enters the label through the engine's
// rexxae_call, in the same context, so the label runs with the script's
// variables as it left them, its arguments the INVOKE's (any number, any
// JSON value), and the step loop below runs it as it runs the script. What
// the label RETURNs (or EXITs) goes back as RETURN; an error in it is RAISE
// with RexxAE's message, after which the context may be called again; END
// ends the worker with DONE 0; a CANCEL during an invocation ends it. The
// names are fixed at READY: EXPORT inside an invocation fails.

import std.guest.child
import std.list
import std.string
import src.engine

// Instructions per step: how often a running script looks for a CANCEL.
const BUDGET = 1000

main() {
    h, err = child.open("rexxae-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    // The mounts, PROBE, LOGLEVEL and the script; a protocol error has been
    // sent to the host as ERROR.
    if child.read_script(h) != "" { exit(1) }

    ctx = engine.rexxae_create(h.source)
    defer engine.rexxae_destroy(ctx)
    engine.rexxae_set_log_level(ctx, h.log_level)
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, lo, hi = child.mount_at(h, i)
        if engine.rexxae_register_function(ctx, name, lo, hi) != 0 {
            child.error(h, "cannot mount ${name} (a builtin, or a bad arity)")
            exit(1)
        }
        i = i + 1
    }
    // EXPORT(name) is the worker's own: the script names a label for the
    // host to call once the script has ended (std.guest's READY and INVOKE).
    if child.is_mounted(h, "EXPORT") || engine.rexxae_register_function(ctx, "EXPORT", 1, 1) != 0 {
        child.error(h, "cannot mount EXPORT: the worker keeps that name for itself")
        exit(1)
    }
    exported = list.new()

    // From here on it grants itself nothing: no files, no network, no
    // processes, with no platform path anywhere.
    child.run(h) callback {
        status = run_script(ctx, h, exported)
        if status == 0 && list.size(exported) > 0 && engine.rexxae_exit_code(ctx) == 0 {
            serve_labels(ctx, h, exported)
        } else if status == 0 {
            child.done(h, engine.rexxae_exit_code(ctx))
        } else if status == -1 {
            child.error(h, string.from_cstr(engine.rexxae_error(ctx)))
        }
    }
    list.free(exported)
    exit(0)
}

// The script ended and EXPORTed labels: READY, then each INVOKE is a call of
// the label in the same context (rexxae_call), run to its end by run_script,
// until END or a cancel. (Not named serve: an unqualified call inside
// child.run's callback block resolves to child's own serve.)
serve_labels(ctx: ptr, h: *child.Host, exported: ptr) {
    names = "["
    k = 0
    while k < list.size(exported) {
        n, _ = list.get_string(exported, k)
        names = if k == 0 { "${names}${child.json_string(n)}" } else { "${names},${child.json_string(n)}" }
        k = k + 1
    }
    child.ready(h, "${names}]")
    while true {
        inv = child.serve(h)
        if inv.kind == "END" {
            child.done(h, 0)
            return
        }
        if inv.kind != "INVOKE" {
            child.error(h, "cancelled by host: ${inv.args}")
            return
        }
        rc = engine.rexxae_call(ctx, inv.name, inv.args)
        if rc == -2 {
            child.raised(h, "no label ${inv.name}")
            continue
        }
        if rc != 0 {
            child.raised(h, "the arguments are not a JSON array")
            continue
        }
        // null: EXPORT is refused from here on, the names being fixed.
        status = run_script(ctx, h, null)
        if status == -2 { return }
        if status == 0 {
            v = engine.rexxae_result_json(ctx)
            child.returned(h, if v == null { "null" } else { string.from_cstr(v) })
        } else {
            child.raised(h, string.from_cstr(engine.rexxae_error(ctx)))
        }
    }
}

// The script, BUDGET instructions at a time, answering each event, to its
// end: 0 (done), -1 (an error) or -2 (cancelled: the ERROR has been sent).
run_script(ctx: ptr, h: *child.Host, exported: ptr) -> int {
    level = h.log_level
    cancelled = 0
    while true {
        status = engine.rexxae_step(ctx, BUDGET)
        if status == 0 { return 0 }
        if status == -1 {
            if h.cancel != "" {
                child.error(h, string.from_cstr(engine.rexxae_error(ctx)))
                return -2
            }
            return -1
        }
        if status == 1 {
            child.say(h, string.from_cstr(engine.rexxae_text(ctx)))
        } else if status == 2 {
            // No ADDRESS environment is mounted: every command is vetoed.
            address = string.from_cstr(engine.rexxae_address(ctx))
            child.audit(h, "rexxae-worker refused ADDRESS ${address}: no environment is mounted")
            engine.rexxae_reply(ctx, 1, "", "ADDRESS ${address} is not mounted")
        } else if status == 5 {
            tags = string.from_cstr(engine.rexxae_log_tags_json(ctx))
            child.log(h, engine.rexxae_log_level(ctx), tags, string.from_cstr(engine.rexxae_text(ctx)))
        } else if status == 4 {
            name = string.from_cstr(engine.rexxae_function(ctx))
            if name == "EXPORT" {
                label = string.from_cstr(engine.rexxae_argument_text(ctx, 0))
                if exported == null {
                    engine.rexxae_reply_value(ctx, "null", "EXPORT: the exports are fixed once the script has ended")
                } else if engine.rexxae_has_label(ctx, label) == 0 {
                    engine.rexxae_reply_value(ctx, "null", "EXPORT: no label ${label}")
                } else {
                    if !listed(exported, label) { list.add(exported, label) }
                    engine.rexxae_reply_value(ctx, "true", "")
                }
                continue
            }
            r = child.call_host(h, name, string.from_cstr(engine.rexxae_arguments_json(ctx)))
            if r.kind == "VALUE" {
                if engine.rexxae_reply_value(ctx, r.text, "") != 0 {
                    engine.rexxae_reply_value(ctx, "null", "the host's reply is not valid JSON")
                }
            } else if r.kind == "FAIL" {
                engine.rexxae_reply_value(ctx, "null", r.text)
            }
        }
        if status != 4 { child.poll(h) }
        if h.cancel != "" && cancelled == 0 {
            engine.rexxae_cancel(ctx, h.cancel)
            cancelled = 1
        }
        // A LOGLEVEL from the host: the engine's threshold from the next step.
        if h.log_level != level {
            level = h.log_level
            engine.rexxae_set_log_level(ctx, level)
        }
    }
}

fn listed(names: ptr, name: string) -> bool {
    i = 0
    while i < list.size(names) {
        n, _ = list.get_string(names, i)
        if n == name { return true }
        i = i + 1
    }
    return false
}
