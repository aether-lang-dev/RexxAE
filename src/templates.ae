// Word and literal-delimiter templates, following the reference's cursor rules.
import std.string
import std.json
import src.state
import src.values

exports(apply, input_text)

input_text(value: ptr, fallback: string) -> string {
    if value == null { return fallback }
    k = values.kind(value)
    text = values.text(value)
    // executeParse uses JavaScript `value || fallback`, not Rexx conditions.
    if k == 0 || (k == 1 && text == "false") || (k == 2 && (text == "0" || text == "NaN")) || (k == 3 && text == "") { return fallback }
    return text
}

apply(ctx: ptr, input: string, tokens: ptr) {
    position = 0
    n = string.length(input)
    count = json.json_array_size(tokens)
    i = 0
    while i < count {
        token = json.json_array_get_raw(tokens, i)
        if state.index(token, "delimiter") == 0 {
            start = position
            end = n
            next = json.json_array_get_raw(tokens, i + 1)
            if next != null && state.index(next, "delimiter") != 0 {
                delimiter = state.text(next, "text")
                found = string.index_of_from(input, delimiter, position)
                if found >= 0 { end = found; position = found + string.length(delimiter) }
                else { position = n }
                i = i + 1
            } else if next != null {
                found = string.index_of_from(input, " ", position)
                if found >= 0 {
                    end = found
                    position = found + 1
                    while position < n && string.char_at_n(input, n, position) == 32 { position = position + 1 }
                } else { position = n }
            } else { position = n }
            // Start is the prior cursor; cursor updates above retain all
            // leading/trailing bytes except spaces skipped between words.
            text = string.substring_n(input, n, start, end)
            name = state.text(token, "text")
            if name != "." {
                value = values.string_value(text)
                state.save(ctx, string.concat("v:", name), value)
                json.json_free(value)
            }
        }
        i = i + 1
    }
}
