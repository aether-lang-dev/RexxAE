// rexxworker: DEPRECATED, for one release. Use Aether's std.guest.
//
// This was the host's side of RexxAE's worker. Nothing in it was about Rexx
// (it drove a MicroQuickJS worker too), so it moved into Aether's standard
// library as std.guest, with the worker's side as std.guest.child; the
// protocol is documented once, in std/guest/README.md. What is left here
// forwards every call to std.guest unchanged, so a host built with
// `--lib path/to/RexxAE/worker` keeps building for one release. Two changes
// a caller sees:
//
//   - the handle is std.guest's: write guest.Guest where a type is named
//     (rexxworker.Worker is gone; Aether has no type aliases);
//   - guest.launch takes the worker's arguments (null for none) after the
//     program; these two pass none, as before;
//   - an audit log that cannot be written is no longer printed to stdout
//     (std modules print nothing unasked); guest.audit returns the error.
//
// Move a host over by replacing `import rexxworker` with `import std.guest`
// and `rexxworker.` with `guest.`. This module is removed in the release
// after the one that ships std.guest.

exports(launch, launch_uncontained, mount, probe, start, next,
    answer, fail, grant_file, deny, cancel, close, audit, json_string,
    printable, log_level, level_name, MAX_FRAME, DEADLINE_MS, GRACE_MS)

import std.guest
import std.sandbox

const MAX_FRAME = 65536
const DEADLINE_MS = 5000
const GRACE_MS = 1000

launch(perms: sandbox.Grants, prog: string, name: string, audit_path: string) -> (guest.Guest, string) {
    return guest.launch(perms, prog, null, name, audit_path)
}

launch_uncontained(perms: sandbox.Grants, prog: string, name: string, audit_path: string) -> (guest.Guest, string) {
    return guest.launch_uncontained(perms, prog, null, name, audit_path)
}

mount(w: *guest.Guest, name: string, min: int, max: int) -> string { return guest.mount(w, name, min, max) }

probe(w: *guest.Guest) -> string { return guest.probe(w) }

log_level(w: *guest.Guest, level: int) -> string { return guest.log_level(w, level) }

start(w: *guest.Guest, source: string) -> string { return guest.start(w, source) }

answer(w: *guest.Guest, json: string) -> string { return guest.answer(w, json) }

fail(w: *guest.Guest, why: string) -> string { return guest.fail(w, why) }

grant_file(w: *guest.Guest, name: string, path: string) -> string { return guest.grant_file(w, name, path) }

deny(w: *guest.Guest, name: string, why: string) -> string { return guest.deny(w, name, why) }

cancel(w: *guest.Guest, reason: string) -> string { return guest.cancel(w, reason) }

next(w: *guest.Guest) -> guest.Event { return guest.next(w) }

close(w: *guest.Guest) { guest.close(w) }

audit(w: *guest.Guest, line: string) { guest.audit(w, line) }

json_string(s: string) -> string { return guest.json_string(s) }

printable(s: string) -> string { return guest.printable(s) }

level_name(level: int) -> string { return guest.level_name(level) }
