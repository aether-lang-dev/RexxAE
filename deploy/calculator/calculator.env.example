# Review binding and firewall rules before using a public interface.
# On a VM, "::" listens on IPv6 and IPv4 (needs Aether with IPv6 std.http,
# after 0.842.0); "0.0.0.0" listens on IPv4 only.
CALC_HOST=127.0.0.1
CALC_PORT=8443
CALC_CERT=/etc/rexxae/fullchain.pem
CALC_KEY=/etc/rexxae/key.pem
CALC_MODULE_FILE=/opt/rexxae/share/calculator.rexx
