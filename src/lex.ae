import std.string
import std.map
import std.strbuilder
import src.state

exports(new, next, symbol, keyword)

new(source: string) -> ptr {
    ctx = map.map_new()
    state.write(ctx, "source", source)
    state.number(ctx, "scan_line", 1)
    next(ctx)
    return ctx
}
symbol(ctx: ptr, text: string) -> bool { return state.integer(ctx, "kind") == 3 && state.read(ctx, "token") == text }
keyword(ctx: ptr, text: string) -> bool { return state.integer(ctx, "kind") == 1 && string.to_upper(state.read(ctx, "token")) == text }

word(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 46
}

// One token of lookahead. Kinds: eof=0, word=1, literal=2, op=3, clause=4.
// Preserve whitespace: blank concatenation differs from || concatenation.
next(ctx: ptr) {
    // Source is immutable and context-owned; borrow it rather than copying
    // the complete program for each token.
    source = map.map_get_raw(ctx, "source")
    n = string.length(source)
    i = state.integer(ctx, "pos")
    line = state.integer(ctx, "scan_line")
    blank = 0
    while i < n {
        c = string.char_at_n(source, n, i)
        d = string.char_at_n(source, n, i + 1)
        if c == 32 || c == 9 || c == 13 {
            blank = 1
            i = i + 1
        } else if (c == 45 && d == 45) || (c == 47 && d == 47) {
            while i < n && string.char_at_n(source, n, i) != 10 { i = i + 1 }
        } else if c == 47 && d == 42 {
            comment_line = line
            i = i + 2
            closed = false
            while i < n {
                if string.char_at_n(source, n, i) == 42 && string.char_at_n(source, n, i + 1) == 47 {
                    i = i + 2
                    closed = true
                    break
                }
                if string.char_at_n(source, n, i) == 10 { line = line + 1 }
                i = i + 1
            }
            blank = 1
            if !closed {
                state.number(ctx, "token_line", comment_line)
                state.fail(ctx, "unterminated comment")
            }
        } else { break }
    }
    state.number(ctx, "token_line", line)
    state.number(ctx, "blank", blank)
    state.number(ctx, "token_start", i)
    kind = 0
    text = ""
    if i < n {
        c = string.char_at_n(source, n, i)
        if c == 10 || c == 59 {
            kind = 4
            i = i + 1
            if c == 10 { line = line + 1 }
        } else if c == 39 || c == 34 {
            kind = 2
            quote = c
            state.number(ctx, "quote", quote)
            i = i + 1
            b = strbuilder.new(32)
            closed = false
            while i < n {
                c = string.char_at_n(source, n, i)
                i = i + 1
                if c == quote {
                    if i < n && string.char_at_n(source, n, i) == quote {
                        strbuilder.append_byte(b, c)
                        i = i + 1
                    } else {
                        closed = true
                        break
                    }
                } else {
                    if c == 10 {
                        state.fail(ctx, "multiline strings are not implemented")
                        line = line + 1
                    }
                    strbuilder.append_byte(b, c)
                }
            }
            text = strbuilder.finish(b)
            if !closed { state.fail(ctx, "unterminated string") }
        } else if word(c) {
            kind = 1
            start = i
            while i < n && word(string.char_at_n(source, n, i)) { i = i + 1 }
            text = string.substring_n(source, n, start, i)
        } else {
            kind = 3
            start = i
            i = i + 1
            d = string.char_at_n(source, n, i)
            if (c == 124 && d == 124) || (c == 38 && d == 38) || (c == 42 && d == 42) || ((c == 61 || c == 60 || c == 62 || c == 33 || c == 92) && d == 61) || (c == 60 && d == 62) {
                i = i + 1
                if c == 92 && string.char_at_n(source, n, i) == 61 { i = i + 1 }
            }
            text = string.substring_n(source, n, start, i)
        }
    }
    state.number(ctx, "pos", i)
    state.number(ctx, "scan_line", line)
    state.number(ctx, "kind", kind)
    state.write(ctx, "token", text)
}
