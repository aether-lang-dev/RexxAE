// Owned typed values. Containers own tagged child values, not borrowed
// pointers. Contexts serialize values so replacing a variable frees storage.
import std.json
import std.math
import std.string
import std.strbuilder
import src.state

exports(wrap, kind, data, string_value, numeric, boolean, null_value,
    clone, text, truth, from_json, to_json, type_name, number_text)

wrap(kind_: int, payload: ptr) -> ptr {
    result = json.obj()
    json.set(result, "kind", json.from_int(kind_))
    json.set(result, "data", payload)
    return result
}
kind(value: ptr) -> int { return state.index(value, "kind") }
data(value: ptr) -> ptr { return state.field(value, "data") }
string_value(value: string) -> ptr { return wrap(3, json.str(value)) }
numeric(value: string) -> ptr { return wrap(2, json.str(value)) }
boolean(value: bool) -> ptr {
    if value { return wrap(1, json.boolean(1)) }
    return wrap(1, json.boolean(0))
}
null_value() -> ptr { return wrap(0, json.null_value()) }
clone(value: ptr) -> ptr {
    encoded, err = json.encode(value)
    if err != "" { return null }
    return json.json_parse_raw(encoded)
}
type_name(value: ptr) -> string {
    k = kind(value)
    if k == 0 { return "null" }
    if k == 1 { return "boolean" }
    if k == 2 { return "number" }
    if k == 3 { return "string" }
    if k == 4 { return "array" }
    return "object"
}
// JavaScript's Number.prototype.toString, which RexxJS prints: the shortest
// decimal that reads back as the same double, laid out as JavaScript lays it
// out (plain below 1e21 and from 1e-6, an exponent outside). std.string's
// from_double gives 17 significant digits (0.33333333333333331 for 1/3);
// this trims them to the fewest that round-trip (0.3333333333333333).
number_text(value: float) -> string {
    if value == 0.0 { return "0" }
    s = string.from_double(value)
    if s == "NaN" || s == "nan" || s == "-nan" { return "NaN" }
    if s == "Infinity" || s == "inf" { return "Infinity" }
    if s == "-Infinity" || s == "-inf" { return "-Infinity" }
    n = string.length(s)
    i = 0
    negative = false
    if string.char_at_n(s, n, 0) == 45 { negative = true; i = 1 }
    // The digits of the mantissa without its point, and where the point is:
    // value = 0.DIGITS * 10^point.
    raw = strbuilder.new(24)
    defer state.release_builder(&raw)
    point = -1
    count = 0
    while i < n && string.char_at_n(s, n, i) != 101 && string.char_at_n(s, n, i) != 69 {
        c = string.char_at_n(s, n, i)
        if c == 46 { point = count } else { strbuilder.append_byte(raw, c); count = count + 1 }
        i = i + 1
    }
    if point < 0 { point = count }
    if i < n { point = point + string.string_get_int(string.substring_n(s, n, i + 1, n)) }
    digits = strbuilder.finish(state.take_ptr(&raw))
    // Leading and trailing zeros carry nothing.
    first = 0
    while first < count - 1 && string.char_at_n(digits, count, first) == 48 { first = first + 1; point = point - 1 }
    last = count
    while last > first + 1 && string.char_at_n(digits, count, last - 1) == 48 { last = last - 1 }
    digits = string.substring_n(digits, count, first, last)
    count = last - first
    // The fewest digits, rounded half up from the 17, that read back the same.
    best = digits
    best_point = point
    p = 1
    while p < count {
        candidate, candidate_point = rounded_digits_(digits, count, p, point)
        probe = "0.${candidate}e${candidate_point}"
        if string.string_try_double(probe) != 0 && string.string_get_double(probe) == math.abs_float(value) {
            best = candidate
            best_point = candidate_point
            break
        }
        p = p + 1
    }
    return js_layout_(negative, best, best_point)
}

// DIGITS rounded half up to `keep` places, without trailing zeros, and the
// point moved by one where the carry runs off the front (999 to 1).
rounded_digits_(digits: string, count: int, keep: int, point: int) -> (string, int) {
    out = strbuilder.new(keep + 1)
    defer state.release_builder(&out)
    carry = 0
    if string.char_at_n(digits, count, keep) >= 53 { carry = 1 }
    // Built from the right, then reversed: a carry runs leftwards.
    reversed = strbuilder.new(keep + 1)
    defer state.release_builder(&reversed)
    j = keep - 1
    while j >= 0 {
        d = string.char_at_n(digits, count, j) - 48 + carry
        if d == 10 { d = 0; carry = 1 } else { carry = 0 }
        strbuilder.append_byte(reversed, 48 + d)
        j = j - 1
    }
    if carry == 1 { strbuilder.append_byte(reversed, 49); point = point + 1 }
    backwards = strbuilder.finish(state.take_ptr(&reversed))
    m = string.length(backwards)
    // Skip the trailing zeros (leading in reverse), then copy the rest back.
    k = 0
    while k < m - 1 && string.char_at_n(backwards, m, k) == 48 { k = k + 1 }
    j = m - 1
    while j >= k {
        strbuilder.append_byte(out, string.char_at_n(backwards, m, j))
        j = j - 1
    }
    return strbuilder.finish(state.take_ptr(&out)), point
}

// Number.prototype.toString's layout of 0.DIGITS * 10^point.
js_layout_(negative: bool, digits: string, point: int) -> string {
    k = string.length(digits)
    out = strbuilder.new(k + 24)
    defer state.release_builder(&out)
    if negative { strbuilder.append_byte(out, 45) }
    if k <= point && point <= 21 {
        strbuilder.append(out, digits)
        z = point - k
        while z > 0 { strbuilder.append_byte(out, 48); z = z - 1 }
    } else if 0 < point && point <= 21 {
        strbuilder.append(out, string.substring_n(digits, k, 0, point))
        strbuilder.append_byte(out, 46)
        strbuilder.append(out, string.substring_n(digits, k, point, k))
    } else if -6 < point && point <= 0 {
        strbuilder.append(out, "0.")
        z = -point
        while z > 0 { strbuilder.append_byte(out, 48); z = z - 1 }
        strbuilder.append(out, digits)
    } else {
        strbuilder.append_byte(out, string.char_at_n(digits, k, 0))
        if k > 1 {
            strbuilder.append_byte(out, 46)
            strbuilder.append(out, string.substring_n(digits, k, 1, k))
        }
        e = point - 1
        if e >= 0 { strbuilder.append(out, "e+") } else { strbuilder.append(out, "e-"); e = -e }
        strbuilder.append_int(out, e)
    }
    return strbuilder.finish(state.take_ptr(&out))
}
text(value: ptr) -> string {
    k = kind(value)
    payload = data(value)
    if k == 0 { return "null" }
    if k == 1 {
        if json.json_get_bool(payload) != 0 { return "true" }
        return "false"
    }
    if k == 2 || k == 3 {
        result, _err = json.get_string(payload)
        return result
    }
    if k == 5 { return "[object Object]" }
    out = strbuilder.new(32)
    defer state.release_builder(&out)
    i = 0
    while i < json.json_array_size(payload) {
        if i > 0 { strbuilder.append_byte(out, 44) }
        child = json.json_array_get_raw(payload, i)
        if kind(child) != 0 { strbuilder.append(out, text(child)) }
        i = i + 1
    }
    return strbuilder.finish(state.take_ptr(&out))
}
// RexxJS conditions treat numeric/string zero and the string 'false' as false.
truth(value: ptr) -> bool {
    k = kind(value)
    if k == 0 { return false }
    if k == 1 { return json.json_get_bool(data(value)) != 0 }
    if k == 4 { return json.json_array_size(data(value)) > 0 }
    if k == 5 { return json.json_object_size_raw(data(value)) > 0 }
    s = text(value)
    if s == "" || s == "0" || string.to_lower(s) == "false" { return false }
    return true
}
from_json(value: ptr, depth: int) -> ptr {
    if depth > 64 { return null }
    k = json.json_type(value)
    if k == 0 { return null_value() }
    if k == 1 { return boolean(json.json_get_bool(value) != 0) }
    if k == 2 { return numeric(number_text(json.json_get_number(value))) }
    if k == 3 {
        s, _err = json.get_string(value)
        return string_value(s)
    }
    result = json.obj()
    if k == 4 { json.json_free(result); result = json.arr() }
    defer state.release_tree(&result)
    n = json.json_object_size_raw(value)
    if k == 4 { n = json.json_array_size(value) }
    i = 0
    while i < n {
        child = json.json_object_value_at(value, i)
        if k == 4 { child = json.json_array_get_raw(value, i) }
        converted = from_json(child, depth + 1)
        if converted == null { return null }
        if k == 4 { json.push(result, converted) }
        else { json.set(result, state.key_at(value, i), converted) }
        i = i + 1
    }
    return wrap(k, state.take_ptr(&result))
}
to_json(value: ptr, depth: int) -> ptr {
    if depth > 64 { return null }
    k = kind(value)
    payload = data(value)
    if k == 0 { return json.null_value() }
    if k == 1 { return json.boolean(json.json_get_bool(payload)) }
    if k == 2 {
        s = text(value)
        if string.string_try_double(s) == 0 || s == "NaN" || string.contains(s, "Infinity") != 0 { return null }
        return json.num(string.string_get_double(s))
    }
    if k == 3 { return json.str(text(value)) }
    result = json.obj()
    if k == 4 { json.json_free(result); result = json.arr() }
    defer state.release_tree(&result)
    n = json.json_object_size_raw(payload)
    if k == 4 { n = json.json_array_size(payload) }
    i = 0
    while i < n {
        child = json.json_object_value_at(payload, i)
        if k == 4 { child = json.json_array_get_raw(payload, i) }
        converted = to_json(child, depth + 1)
        if converted == null { return null }
        if k == 4 { json.push(result, converted) }
        else { json.set(result, state.key_at(payload, i), converted) }
        i = i + 1
    }
    return state.take_ptr(&result)
}
