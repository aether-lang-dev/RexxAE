// RexxJS core library functions that take or give typed values, beyond the
// scalar text and math set in builtins.ae. Each follows RexxJS's behaviour
// (core/src/*-functions.js), except where RexxJS departs from classic Rexx in
// a way that looks like a bug; those are recorded in
// tests/known_differences.json and docs/rexxjs-suggestions.md.
import std.string
import std.map
import std.strbuilder
import std.json
import std.math
import src.state
import src.values
import src.variables

exports(known, call, stack_push, stack_queue, stack_pull, stack_size)

const LIBRARY_FUNCTIONS = " DATATYPE SYMBOL AND OR IFS STACK_PUSH STACK_PULL STACK_QUEUE STACK_SIZE STACK_PEEK STACK_CLEAR ARRAY_POP ARRAY_SHIFT ARRAY_REVERSE ARRAY_SLICE ARRAY_CONCAT ARRAY_INCLUDES ARRAY_INDEXOF ARRAY_SUM ARRAY_MIN ARRAY_MAX ARRAY_AVERAGE ARRAY_UNIQUE JSON_VALID JSON_HAS JSON_SET JSON_DELETE JSON_VALUES JSON_MERGE URL_ENCODE URL_DECODE BASE64_ENCODE BASE64_DECODE "

known(name: string) -> bool {
    return string.contains(LIBRARY_FUNCTIONS, string.concat(string.concat(" ", name), " ")) != 0
}

// The external data queue (PUSH, QUEUE, PULL and the STACK_ functions): one
// per context, its lines under q:<n> for n from stack_lo up to stack_hi, the
// top at stack_hi - 1. Every operation is constant time; QUEUE at the bottom
// does not move the other lines.
stack_slot_(n: int) -> string { return string.concat("q:", string.from_int(n)) }
stack_size(ctx: ptr) -> int { return state.integer(ctx, "stack_hi") - state.integer(ctx, "stack_lo") }
stack_push(ctx: ptr, line: string) -> int {
    hi = state.integer(ctx, "stack_hi")
    state.write(ctx, stack_slot_(hi), line)
    state.number(ctx, "stack_hi", hi + 1)
    return stack_size(ctx)
}
stack_queue(ctx: ptr, line: string) -> int {
    lo = state.integer(ctx, "stack_lo") - 1
    state.write(ctx, stack_slot_(lo), line)
    state.number(ctx, "stack_lo", lo)
    return stack_size(ctx)
}
// The top line, removed; "" when the queue is empty.
stack_pull(ctx: ptr) -> string {
    if stack_size(ctx) <= 0 { return "" }
    hi = state.integer(ctx, "stack_hi") - 1
    key = stack_slot_(hi)
    line = state.read(ctx, key)
    map.map_remove(ctx, key)
    state.number(ctx, "stack_hi", hi)
    return line
}
stack_clear_(ctx: ptr) -> int {
    count = stack_size(ctx)
    while stack_size(ctx) > 0 { stack_pull(ctx) }
    state.number(ctx, "stack_lo", 0)
    state.number(ctx, "stack_hi", 0)
    return count
}

argument_(args: ptr, i: int) -> ptr { return json.json_array_get_raw(args, i) }

// JavaScript's Boolean(value) for a typed value: what RexxJS's IFS tests.
js_truthy_(value: ptr) -> bool {
    k = values.kind(value)
    if k == 0 { return false }
    if k == 1 { return json.json_get_bool(values.data(value)) != 0 }
    if k == 2 {
        s = values.text(value)
        return s != "0" && s != "-0" && s != "NaN"
    }
    if k == 3 { return values.text(value) != "" }
    return true
}

// What RexxJS's AND and OR count as true: a string only when it reads
// "true" (in any case), anything else as Boolean(value).
logic_true_(value: ptr) -> bool {
    if values.kind(value) == 3 { return string.to_lower(values.text(value)) == "true" }
    return js_truthy_(value)
}

blank_(c: int) -> bool { return c == 32 || c == 9 }
digit_(c: int) -> bool { return c >= 48 && c <= 57 }
lower_(c: int) -> bool { return c >= 97 && c <= 122 }
upper_(c: int) -> bool { return c >= 65 && c <= 90 }

// A classic Rexx number: blanks, a sign, blanks, digits with at most one
// point (at least one digit), an exponent E[sign]digits, blanks.
classic_number_(s: string) -> bool {
    n = string.length(s)
    i = 0
    while i < n && blank_(string.char_at_n(s, n, i)) { i = i + 1 }
    if i < n && (string.char_at_n(s, n, i) == 43 || string.char_at_n(s, n, i) == 45) {
        i = i + 1
        while i < n && blank_(string.char_at_n(s, n, i)) { i = i + 1 }
    }
    digits = 0
    while i < n && digit_(string.char_at_n(s, n, i)) { i = i + 1; digits = digits + 1 }
    if i < n && string.char_at_n(s, n, i) == 46 {
        i = i + 1
        while i < n && digit_(string.char_at_n(s, n, i)) { i = i + 1; digits = digits + 1 }
    }
    if digits == 0 { return false }
    if i < n && (string.char_at_n(s, n, i) == 69 || string.char_at_n(s, n, i) == 101) {
        i = i + 1
        if i < n && (string.char_at_n(s, n, i) == 43 || string.char_at_n(s, n, i) == 45) { i = i + 1 }
        exponent = 0
        while i < n && digit_(string.char_at_n(s, n, i)) { i = i + 1; exponent = exponent + 1 }
        if exponent == 0 { return false }
    }
    while i < n && blank_(string.char_at_n(s, n, i)) { i = i + 1 }
    return i == n
}

// Every character of `s` (at least one) passes the class test.
all_of_(s: string, kind: int) -> bool {
    n = string.length(s)
    if n == 0 { return false }
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        ok = false
        if kind == 0 { ok = lower_(c) || upper_(c) || digit_(c) }
        else if kind == 1 { ok = lower_(c) }
        else if kind == 2 { ok = upper_(c) }
        else if kind == 3 { ok = lower_(c) || upper_(c) }
        else { ok = lower_(c) || upper_(c) || digit_(c) || c == 46 || c == 33 || c == 63 || c == 95 }
        if !ok { return false }
        i = i + 1
    }
    return true
}

// A binary (width 4) or hexadecimal (width 2) string as classic Rexx writes
// one: digits, optionally in groups split by blanks, every group after the
// first exactly `width` digits; no blank at either end. Empty is valid.
grouped_digits_(s: string, hex: bool) -> bool {
    n = string.length(s)
    if n == 0 { return true }
    width = 4
    if hex { width = 2 }
    if blank_(string.char_at_n(s, n, 0)) || blank_(string.char_at_n(s, n, n - 1)) { return false }
    group = 0
    first = true
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if blank_(c) {
            if group > 0 {
                if !first && group != width { return false }
                first = false
                group = 0
            }
        } else {
            ok = c == 48 || c == 49
            if hex { ok = digit_(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) }
            if !ok { return false }
            group = group + 1
        }
        i = i + 1
    }
    return first || group == width
}

// DATATYPE(value): RexxJS's names, NUM and CHAR for text (the classic
// answers) and BOOL, ARRAY, OBJECT or NULL for typed values.
datatype_name_(value: ptr) -> string {
    k = values.kind(value)
    if k == 0 { return "NULL" }
    if k == 1 { return "BOOL" }
    if k == 2 { return "NUM" }
    if k == 4 { return "ARRAY" }
    if k == 5 { return "OBJECT" }
    if classic_number_(values.text(value)) { return "NUM" }
    return "CHAR"
}

datatype_(ctx: ptr, args: ptr) -> ptr {
    count = json.json_array_size(args)
    if count == 0 || count > 2 { state.fail(ctx, "DATATYPE requires one or two arguments"); return null }
    value = argument_(args, 0)
    name = datatype_name_(value)
    if count == 1 { return values.string_value(name) }
    option = string.to_upper(string.trim(values.text(argument_(args, 1))))
    // RexxJS's form: a type name, answered true or false.
    if option == "NUM" || option == "CHAR" || option == "BOOL" || option == "ARRAY" || option == "OBJECT" || option == "NULL" {
        return values.boolean(option == name)
    }
    // The classic form: one option letter, answered 1 or 0.
    if string.length(option) != 1 { state.fail(ctx, "DATATYPE option must be one of A B L M N S U W X, or a type name"); return null }
    s = values.text(value)
    ok = false
    if option == "A" { ok = all_of_(s, 0) }
    else if option == "B" { ok = grouped_digits_(s, false) }
    else if option == "L" { ok = all_of_(s, 1) }
    else if option == "U" { ok = all_of_(s, 2) }
    else if option == "M" { ok = all_of_(s, 3) }
    else if option == "S" { ok = all_of_(s, 4) }
    else if option == "N" { ok = classic_number_(s) }
    else if option == "W" {
        if classic_number_(s) {
            trimmed = string.trim(s)
            if string.string_try_double(trimmed) != 0 {
                d = string.string_get_double(trimmed)
                ok = d - d == 0.0 && math.floor(d) == d
            }
        }
    }
    else if option == "X" { ok = grouped_digits_(s, true) }
    else { state.fail(ctx, "DATATYPE option must be one of A B L M N S U W X, or a type name"); return null }
    if ok { return values.numeric("1") }
    return values.numeric("0")
}

// SYMBOL(name): BAD when the text is not a Rexx symbol, LIT for a constant
// symbol (it starts with a digit or a point) or an unset variable, VAR for a
// set one. Tails are substituted as in a script.
symbol_(ctx: ptr, args: ptr) -> ptr {
    if json.json_array_size(args) != 1 { state.fail(ctx, "SYMBOL requires one argument"); return null }
    name = values.text(argument_(args, 0))
    if !all_of_(name, 4) { return values.string_value("BAD") }
    c = string.char_at_n(name, string.length(name), 0)
    if digit_(c) || c == 46 { return values.string_value("LIT") }
    found = variables.get(ctx, variables.derived(ctx, name))
    if found == null { return values.string_value("LIT") }
    json.json_free(found)
    return values.string_value("VAR")
}

// An array argument as RexxJS takes one: an array, or text holding a JSON
// array. An owned typed array, or null after failing.
array_arg_(ctx: ptr, name: string, value: ptr) -> ptr {
    if values.kind(value) == 4 { return values.clone(value) }
    if values.kind(value) == 3 {
        raw = json.json_parse_raw(values.text(value))
        if raw != null {
            converted = values.from_json(raw, 0)
            json.json_free(raw)
            if converted != null && values.kind(converted) == 4 { return converted }
            if converted != null { json.json_free(converted) }
        }
    }
    state.fail(ctx, string.concat(name, " requires an array or a JSON array text"))
    return null
}

// JavaScript's Number(value) for a typed value; false for NaN.
js_number_(value: ptr) -> (float, bool) {
    k = values.kind(value)
    if k == 0 { return 0.0, true }
    if k == 1 {
        if json.json_get_bool(values.data(value)) != 0 { return 1.0, true }
        return 0.0, true
    }
    if k == 4 || k == 5 { return 0.0, false }
    s = string.trim(values.text(value))
    if s == "" { return 0.0, true }
    if s == "Infinity" || s == "+Infinity" { return 1.0e308 * 10.0, true }
    if s == "-Infinity" { return -1.0e308 * 10.0, true }
    if !classic_number_(s) || string.index_of(s, " ") >= 0 { return 0.0, false }
    if string.string_try_double(s) == 0 { return 0.0, false }
    return string.string_get_double(s), true
}

// JavaScript's SameValueZero between two typed values: primitives by type and
// value, containers never (each is its own object).
same_value_(a: ptr, b: ptr) -> bool {
    k = values.kind(a)
    if k != values.kind(b) || k == 4 || k == 5 { return false }
    if k == 2 {
        x, _ok = js_number_(a)
        y, _ok2 = js_number_(b)
        return x == y
    }
    return values.text(a) == values.text(b)
}

// JavaScript parseInt(text) || fallback, for slice bounds.
js_int_(value: ptr, fallback: int) -> int {
    s = string.trim(values.text(value))
    n = string.length(s)
    i = 0
    negative = false
    if i < n && (string.char_at_n(s, n, i) == 43 || string.char_at_n(s, n, i) == 45) { negative = string.char_at_n(s, n, i) == 45; i = i + 1 }
    start = i
    while i < n && digit_(string.char_at_n(s, n, i)) && i - start < 9 { i = i + 1 }
    if i == start { return fallback }
    v = string.string_get_int(string.substring_n(s, n, start, i))
    if negative { v = -v }
    return v
}

array_call_(ctx: ptr, name: string, args: ptr) -> ptr {
    count = json.json_array_size(args)
    if count == 0 { state.fail(ctx, string.concat(name, " requires an array")); return null }
    arr = array_arg_(ctx, name, argument_(args, 0))
    if arr == null { return null }
    defer json.json_free(arr)
    items = values.data(arr)
    size = json.json_array_size(items)
    if name == "ARRAY_POP" || name == "ARRAY_SHIFT" {
        // RexxJS gives JavaScript's undefined for an empty array; RexxAE "".
        if size == 0 { return values.string_value("") }
        if name == "ARRAY_POP" { return values.clone(json.json_array_get_raw(items, size - 1)) }
        return values.clone(json.json_array_get_raw(items, 0))
    }
    if name == "ARRAY_SUM" || name == "ARRAY_MIN" || name == "ARRAY_MAX" || name == "ARRAY_AVERAGE" {
        // Number() of each item, NaN dropped, as RexxJS does.
        total = 0.0
        low = 0.0
        high = 0.0
        numbers = 0
        i = 0
        while i < size {
            x, ok = js_number_(json.json_array_get_raw(items, i))
            if ok {
                if numbers == 0 || x < low { low = x }
                if numbers == 0 || x > high { high = x }
                total = total + x
                numbers = numbers + 1
            }
            i = i + 1
        }
        if name == "ARRAY_SUM" { return values.numeric(values.number_text(total)) }
        if name == "ARRAY_AVERAGE" {
            if numbers == 0 { return values.numeric("0") }
            return values.numeric(values.number_text(total / numbers))
        }
        if numbers == 0 { return values.null_value() }
        if name == "ARRAY_MIN" { return values.numeric(values.number_text(low)) }
        return values.numeric(values.number_text(high))
    }
    if name == "ARRAY_INCLUDES" || name == "ARRAY_INDEXOF" {
        if count < 2 { state.fail(ctx, string.concat(name, " requires an item")); return null }
        item = argument_(args, 1)
        i = 0
        while i < size {
            if same_value_(json.json_array_get_raw(items, i), item) {
                if name == "ARRAY_INCLUDES" { return values.boolean(true) }
                return values.numeric(string.from_int(i))
            }
            i = i + 1
        }
        if name == "ARRAY_INCLUDES" { return values.boolean(false) }
        return values.numeric("-1")
    }
    result = json.arr()
    if name == "ARRAY_REVERSE" {
        i = size - 1
        while i >= 0 { json.push(result, values.clone(json.json_array_get_raw(items, i))); i = i - 1 }
    } else if name == "ARRAY_SLICE" {
        // Array.prototype.slice(start, end): negative counts from the end.
        first = 0
        if count > 1 { first = js_int_(argument_(args, 1), 0) }
        last = size
        if count > 2 { last = js_int_(argument_(args, 2), 0) }
        if first < 0 { first = first + size }
        if first < 0 { first = 0 }
        if last < 0 { last = last + size }
        if last > size { last = size }
        i = first
        while i < last { json.push(result, values.clone(json.json_array_get_raw(items, i))); i = i + 1 }
    } else if name == "ARRAY_CONCAT" {
        i = 0
        while i < size { json.push(result, values.clone(json.json_array_get_raw(items, i))); i = i + 1 }
        if count > 1 {
            other = array_arg_(ctx, name, argument_(args, 1))
            if other == null { json.json_free(result); return null }
            j = 0
            while j < json.json_array_size(values.data(other)) { json.push(result, values.clone(json.json_array_get_raw(values.data(other), j))); j = j + 1 }
            json.json_free(other)
        }
    } else {
        // ARRAY_UNIQUE: first of each primitive (by type and value), every
        // container (each is its own object). One pass with a set of keys.
        seen = map.map_new()
        defer map.map_free(seen)
        i = 0
        while i < size {
            child = json.json_array_get_raw(items, i)
            k = values.kind(child)
            keep = true
            if k != 4 && k != 5 {
                key = string.concat(string.from_int(k), string.concat(":", values.text(child)))
                if k == 2 {
                    x, _ok = js_number_(child)
                    key = string.concat("2:", values.number_text(x))
                }
                if map.map_has(seen, key) != 0 { keep = false }
                else { state.write(seen, key, "1") }
            }
            if keep { json.push(result, values.clone(child)) }
            i = i + 1
        }
    }
    return values.wrap(4, result)
}

// ---- JSON documents (RexxJS json-functions.js): an object or JSON text in,
// paths split at points, JSON text out for SET, DELETE and MERGE.

// The argument as a raw JSON tree (owned), or null when it is not JSON.
json_tree_(value: ptr) -> ptr {
    k = values.kind(value)
    if k == 4 || k == 5 { return values.to_json(value, 0) }
    if k == 3 { return json.json_parse_raw(values.text(value)) }
    return null
}
clone_tree_(node: ptr) -> ptr {
    encoded, err = json.encode(node)
    if err != "" { return null }
    return json.json_parse_raw(encoded)
}
encoded_(ctx: ptr, tree: ptr) -> ptr {
    text, err = json.encode(tree)
    if err != "" { state.fail(ctx, err); return null }
    return values.string_value(text)
}
// The child of an object (by key) or an array (by index text), borrowed.
child_(node: ptr, part: string) -> ptr {
    t = json.json_type(node)
    if t == 5 { return json.json_object_get_raw(node, part) }
    if t == 4 && string.string_try_int(part) != 0 && string.from_int(string.string_get_int(part)) == part {
        return json.json_array_get_raw(node, string.string_get_int(part))
    }
    return null
}
// A copy of `node` with the path from `parts[at]` set to `value` (or the
// last part removed when `value` is null). Missing or non-object steps become
// {} as RexxJS makes them. Returns null when an array step cannot hold it.
rebuilt_(node: ptr, parts: ptr, at: int, value: ptr, depth: int) -> ptr {
    if depth > 64 { return null }
    part = json.json_get_string_raw(json.json_array_get_raw(parts, at))
    last = at == json.json_array_size(parts) - 1
    t = json.json_type(node)
    if t == 4 {
        size = json.json_array_size(node)
        index = -1
        if string.string_try_int(part) != 0 && string.from_int(string.string_get_int(part)) == part { index = string.string_get_int(part) }
        if index < 0 || index > size || (index == size && (value == null || !last)) { return null }
        out = json.arr()
        i = 0
        while i < size {
            if i == index {
                if last { if value != null { json.push(out, clone_tree_(value)) } }
                else {
                    inner = rebuilt_(json.json_array_get_raw(node, i), parts, at + 1, value, depth + 1)
                    if inner == null { json.json_free(out); return null }
                    json.push(out, inner)
                }
            } else { json.push(out, clone_tree_(json.json_array_get_raw(node, i))) }
            i = i + 1
        }
        if index == size { json.push(out, clone_tree_(value)) }
        return out
    }
    out = json.obj()
    found = false
    if t == 5 {
        i = 0
        while i < json.json_object_size_raw(node) {
            key = state.key_at(node, i)
            child = json.json_object_value_at(node, i)
            if key == part {
                found = true
                if last { if value != null { json.set(out, key, clone_tree_(value)) } }
                else {
                    next = child
                    if json.json_type(child) != 4 && json.json_type(child) != 5 { next = null }
                    inner = null
                    if next == null {
                        if value == null { inner = clone_tree_(child) }
                        else { empty = json.obj(); inner = rebuilt_(empty, parts, at + 1, value, depth + 1); json.json_free(empty) }
                    } else { inner = rebuilt_(next, parts, at + 1, value, depth + 1) }
                    if inner == null { json.json_free(out); return null }
                    json.set(out, key, inner)
                }
            } else { json.set(out, key, clone_tree_(child)) }
            i = i + 1
        }
    }
    if !found && value != null {
        if last { json.set(out, part, clone_tree_(value)) }
        else {
            empty = json.obj()
            inner = rebuilt_(empty, parts, at + 1, value, depth + 1)
            json.json_free(empty)
            if inner == null { json.json_free(out); return null }
            json.set(out, part, inner)
        }
    }
    return out
}
path_parts_(path: string) -> ptr {
    parts = json.arr()
    n = string.length(path)
    start = 0
    i = 0
    while i <= n {
        if i == n || string.char_at_n(path, n, i) == 46 {
            json.push(parts, json.str(string.substring_n(path, n, start, i)))
            start = i + 1
        }
        i = i + 1
    }
    return parts
}

json_call_(ctx: ptr, name: string, args: ptr) -> ptr {
    count = json.json_array_size(args)
    if count == 0 { state.fail(ctx, string.concat(name, " requires a JSON value")); return null }
    if name == "JSON_VALID" {
        if values.kind(argument_(args, 0)) != 3 && values.kind(argument_(args, 0)) != 2 { return values.boolean(false) }
        raw = json.json_parse_raw(values.text(argument_(args, 0)))
        if raw == null { return values.boolean(false) }
        json.json_free(raw)
        return values.boolean(true)
    }
    tree = json_tree_(argument_(args, 0))
    if tree == null {
        // RexxJS returns its input for SET, DELETE and MERGE when it is not
        // JSON, false for HAS and [] for VALUES.
        if name == "JSON_HAS" { return values.boolean(false) }
        if name == "JSON_VALUES" { return values.wrap(4, json.arr()) }
        return values.clone(argument_(args, 0))
    }
    defer json.json_free(tree)
    if name == "JSON_VALUES" {
        result = json.arr()
        if json.json_type(tree) == 5 {
            i = 0
            while i < json.json_object_size_raw(tree) {
                converted = values.from_json(json.json_object_value_at(tree, i), 0)
                if converted != null { json.push(result, converted) }
                i = i + 1
            }
        }
        return values.wrap(4, result)
    }
    if name == "JSON_MERGE" {
        other = null
        if count > 1 { other = json_tree_(argument_(args, 1)) }
        if other == null || json.json_type(tree) != 5 || json.json_type(other) != 5 {
            if other != null { json.json_free(other) }
            return values.clone(argument_(args, 0))
        }
        defer json.json_free(other)
        merged = json.obj()
        defer json.json_free(merged)
        i = 0
        while i < json.json_object_size_raw(tree) {
            key = state.key_at(tree, i)
            source = json.json_object_get_raw(other, key)
            if source == null { source = json.json_object_value_at(tree, i) }
            json.set(merged, key, clone_tree_(source))
            i = i + 1
        }
        i = 0
        while i < json.json_object_size_raw(other) {
            key = state.key_at(other, i)
            if json.json_object_get_raw(tree, key) == null { json.set(merged, key, clone_tree_(json.json_object_value_at(other, i))) }
            i = i + 1
        }
        return encoded_(ctx, merged)
    }
    if count < 2 { state.fail(ctx, string.concat(name, " requires a path")); return null }
    parts = path_parts_(values.text(argument_(args, 1)))
    defer json.json_free(parts)
    if name == "JSON_HAS" {
        current = tree
        i = 0
        while i < json.json_array_size(parts) {
            current = child_(current, json.json_get_string_raw(json.json_array_get_raw(parts, i)))
            if current == null { return values.boolean(false) }
            i = i + 1
        }
        return values.boolean(true)
    }
    if name == "JSON_DELETE" {
        // Unchanged (as JSON text) when the path does not reach a value.
        current = tree
        i = 0
        while i < json.json_array_size(parts) && current != null {
            current = child_(current, json.json_get_string_raw(json.json_array_get_raw(parts, i)))
            i = i + 1
        }
        if current == null || json.json_type(tree) != 5 { return encoded_(ctx, tree) }
        out = rebuilt_(tree, parts, 0, null, 0)
        if out == null { return encoded_(ctx, tree) }
        defer json.json_free(out)
        return encoded_(ctx, out)
    }
    // JSON_SET
    value = values.string_value("")
    if count > 2 { json.json_free(value); value = values.clone(argument_(args, 2)) }
    defer json.json_free(value)
    raw = values.to_json(value, 0)
    if raw == null { state.fail(ctx, "JSON_SET value cannot be represented as JSON"); return null }
    defer json.json_free(raw)
    if json.json_type(tree) != 5 && json.json_type(tree) != 4 { return values.clone(argument_(args, 0)) }
    out = rebuilt_(tree, parts, 0, raw, 0)
    if out == null { state.fail(ctx, "JSON_SET cannot place that path in an array"); return null }
    defer json.json_free(out)
    return encoded_(ctx, out)
}

// ---- URL and Base64 (url-functions.js, cryptography-functions.js).
const HEX = "0123456789ABCDEF"
const B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// encodeURIComponent over the text's UTF-8 bytes.
url_encode_(s: string) -> string {
    n = string.length(s)
    out = strbuilder.new(n + 8)
    defer state.release_builder(&out)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c < 0 { c = c + 256 }
        if lower_(c) || upper_(c) || digit_(c) || c == 45 || c == 95 || c == 46 || c == 33 || c == 126 || c == 42 || c == 39 || c == 40 || c == 41 {
            strbuilder.append_byte(out, c)
        } else {
            strbuilder.append_byte(out, 37)
            strbuilder.append_byte(out, string.char_at(HEX, c / 16))
            strbuilder.append_byte(out, string.char_at(HEX, c % 16))
        }
        i = i + 1
    }
    return strbuilder.finish(state.take_ptr(&out))
}
hex_value_(c: int) -> int {
    if digit_(c) { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    return -1
}
// Whether the bytes are well-formed UTF-8, as decodeURIComponent requires.
utf8_valid_(s: string) -> bool {
    n = string.length(s)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c < 0 { c = c + 256 }
        extra = 0
        if c < 128 { extra = 0 }
        else if c >= 194 && c <= 223 { extra = 1 }
        else if c >= 224 && c <= 239 { extra = 2 }
        else if c >= 240 && c <= 244 { extra = 3 }
        else { return false }
        if i + extra > n - 1 { return false }
        j = 1
        while j <= extra {
            d = string.char_at_n(s, n, i + j)
            if d < 0 { d = d + 256 }
            if d < 128 || d > 191 { return false }
            j = j + 1
        }
        i = i + extra + 1
    }
    return true
}
// decodeURIComponent; "" for a malformed escape or bytes that are not UTF-8.
url_decode_(s: string) -> string {
    n = string.length(s)
    out = strbuilder.new(n)
    defer state.release_builder(&out)
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c == 37 {
            if i + 2 > n - 1 { return "" }
            hi = hex_value_(string.char_at_n(s, n, i + 1))
            lo = hex_value_(string.char_at_n(s, n, i + 2))
            if hi < 0 || lo < 0 { return "" }
            strbuilder.append_byte(out, hi * 16 + lo)
            i = i + 3
        } else {
            strbuilder.append_byte(out, c)
            i = i + 1
        }
    }
    decoded = strbuilder.finish(state.take_ptr(&out))
    if !utf8_valid_(decoded) { return "" }
    return decoded
}
base64_encode_(s: string) -> string {
    n = string.length(s)
    out = strbuilder.new(n / 3 * 4 + 8)
    defer state.release_builder(&out)
    i = 0
    while i < n {
        a = string.char_at_n(s, n, i)
        if a < 0 { a = a + 256 }
        b = 0
        c = 0
        if i + 1 < n { b = string.char_at_n(s, n, i + 1); if b < 0 { b = b + 256 } }
        if i + 2 < n { c = string.char_at_n(s, n, i + 2); if c < 0 { c = c + 256 } }
        triple = a * 65536 + b * 256 + c
        strbuilder.append_byte(out, string.char_at(B64, triple / 262144 % 64))
        strbuilder.append_byte(out, string.char_at(B64, triple / 4096 % 64))
        if i + 1 < n { strbuilder.append_byte(out, string.char_at(B64, triple / 64 % 64)) } else { strbuilder.append_byte(out, 61) }
        if i + 2 < n { strbuilder.append_byte(out, string.char_at(B64, triple % 64)) } else { strbuilder.append_byte(out, 61) }
        i = i + 3
    }
    return strbuilder.finish(state.take_ptr(&out))
}
b64_value_(c: int) -> int {
    if upper_(c) { return c - 65 }
    if lower_(c) { return c - 71 }
    if digit_(c) { return c + 4 }
    if c == 43 || c == 45 { return 62 }
    if c == 47 || c == 95 { return 63 }
    return -1
}
// Base64 (or base64url) text to bytes: blanks and padding are skipped; an
// error for any other character, or a lone sixth bit group.
base64_decode_(s: string) -> (string, bool) {
    n = string.length(s)
    out = strbuilder.new(n)
    defer state.release_builder(&out)
    bits = 0
    held = 0
    groups = 0
    i = 0
    while i < n {
        c = string.char_at_n(s, n, i)
        if c != 61 && !blank_(c) && c != 10 && c != 13 {
            v = b64_value_(c)
            if v < 0 { return "", false }
            bits = bits * 64 + v
            held = held + 6
            groups = groups + 1
            if held >= 8 {
                held = held - 8
                strbuilder.append_byte(out, bits / pow2_(held) % 256)
                bits = bits % pow2_(held)
            }
        }
        i = i + 1
    }
    if groups % 4 == 1 { return "", false }
    return strbuilder.finish(state.take_ptr(&out)), true
}
pow2_(k: int) -> int {
    r = 1
    while k > 0 { r = r * 2; k = k - 1 }
    return r
}

call(ctx: ptr, name: string, args: ptr) -> ptr {
    count = json.json_array_size(args)
    if string.starts_with(name, "ARRAY_") != 0 { return array_call_(ctx, name, args) }
    if string.starts_with(name, "JSON_") != 0 { return json_call_(ctx, name, args) }
    if name == "URL_ENCODE" || name == "URL_DECODE" || name == "BASE64_ENCODE" || name == "BASE64_DECODE" {
        text = ""
        if count > 0 { text = values.text(argument_(args, 0)) }
        if name == "URL_ENCODE" { return values.string_value(url_encode_(text)) }
        if name == "URL_DECODE" { return values.string_value(url_decode_(text)) }
        if name == "BASE64_ENCODE" { return values.string_value(base64_encode_(text)) }
        decoded, ok = base64_decode_(text)
        if !ok { state.fail(ctx, "Invalid base64 input"); return null }
        return values.string_value(decoded)
    }
    if name == "DATATYPE" { return datatype_(ctx, args) }
    if name == "SYMBOL" { return symbol_(ctx, args) }
    if name == "AND" || name == "OR" {
        // RexxJS: values.every / values.some; with no arguments both give
        // false (RexxJS's converter passes one undefined).
        all = count > 0
        any = false
        i = 0
        while i < count {
            if logic_true_(argument_(args, i)) { any = true } else { all = false }
            i = i + 1
        }
        if name == "AND" { return values.boolean(all) }
        return values.boolean(any)
    }
    if string.starts_with(name, "STACK_") != 0 {
        // RexxJS's STACK_ functions; values go on as text (String(value || '')).
        if name == "STACK_PUSH" || name == "STACK_QUEUE" {
            line = ""
            if count > 0 && js_truthy_(argument_(args, 0)) { line = values.text(argument_(args, 0)) }
            size = 0
            if name == "STACK_PUSH" { size = stack_push(ctx, line) } else { size = stack_queue(ctx, line) }
            return values.numeric(string.from_int(size))
        }
        if name == "STACK_PULL" { return values.string_value(stack_pull(ctx)) }
        if name == "STACK_SIZE" { return values.numeric(string.from_int(stack_size(ctx))) }
        if name == "STACK_CLEAR" { return values.numeric(string.from_int(stack_clear_(ctx))) }
        if stack_size(ctx) <= 0 { return values.string_value("") }
        return values.string_value(state.read(ctx, stack_slot_(state.integer(ctx, "stack_hi") - 1)))
    }
    if name == "IFS" {
        // IFS(test1, value1, test2, value2, ..., [default]): the value after
        // the first test JavaScript counts as true; the odd last argument as
        // the default, otherwise "".
        i = 0
        while i + 1 < count {
            if js_truthy_(argument_(args, i)) { return values.clone(argument_(args, i + 1)) }
            i = i + 2
        }
        if count % 2 == 1 { return values.clone(argument_(args, count - 1)) }
        return values.string_value("")
    }
    state.fail(ctx, string.concat("unknown library function: ", name))
    return null
}
