// The RexxJS core library functions in src/library.ae, natively: the classic
// forms RexxJS answers differently (tests/known_differences.json) as well as
// the edges the golden fixtures (tests/function_cases.json) leave out.
import std.spec
import std.string
import std.strbuilder
import src.engine

said(source: string) -> string {
    ctx = engine.rexxae_create(source)
    defer engine.rexxae_destroy(ctx)
    out = strbuilder.new(32)
    status = 3
    count = 0
    while status > 0 && count < 10000 {
        status = engine.rexxae_step(ctx, 100)
        if status == 1 {
            if strbuilder.length(out) > 0 { strbuilder.append_byte(out, 32) }
            strbuilder.append(out, string.from_cstr(engine.rexxae_text(ctx)))
        }
        if status == 2 || status == 4 { strbuilder.free(out); return "unexpected host request" }
        count = count + 1
    }
    if status == -1 {
        strbuilder.free(out)
        return "ERROR ${string.from_cstr(engine.rexxae_error(ctx))}"
    }
    return strbuilder.finish(out)
}


main() {
    fw = spec.init()
    spec.describe(fw, "DATATYPE") {
        spec.it("names text NUM or CHAR by classic number syntax") callback {
            spec.assert_str_eq(said("SAY DATATYPE('12')\nSAY DATATYPE(' -1.5E+3 ')\nSAY DATATYPE('- 5')\nSAY DATATYPE('.5')\nSAY DATATYPE('5.')"), "NUM NUM NUM NUM NUM", "numbers")
            spec.assert_str_eq(said("SAY DATATYPE('0x1F')\nSAY DATATYPE('1e')\nSAY DATATYPE('1.2.3')\nSAY DATATYPE('  ')\nSAY DATATYPE('Infinity')\nSAY DATATYPE('--1')"), "CHAR CHAR CHAR CHAR CHAR CHAR", "not numbers")
        }
        spec.it("names typed values as RexxJS does") callback {
            spec.assert_str_eq(said("LET b = true\nSAY DATATYPE(b)\nSAY DATATYPE(JSON_PARSE('null'))\nLET n = 3\nSAY DATATYPE(n)"), "BOOL NULL NUM", "typed")
        }
        spec.it("answers the classic option letters with 1 or 0") callback {
            spec.assert_str_eq(said("SAY DATATYPE('12', 'W') DATATYPE('1.5', 'W') DATATYPE('1E3', 'w') DATATYPE('x', 'W')"), "1 0 1 0", "W")
            spec.assert_str_eq(said("SAY DATATYPE('aB1', 'A') DATATYPE('a b', 'A') DATATYPE('', 'A')"), "1 0 0", "A")
            spec.assert_str_eq(said("SAY DATATYPE('ab', 'L') DATATYPE('aB', 'L') DATATYPE('AB', 'U') DATATYPE('aB', 'M') DATATYPE('a1', 'M')"), "1 0 1 1 0", "L U M")
            spec.assert_str_eq(said("SAY DATATYPE(' 1 ', 'N') DATATYPE('abc', 'N')"), "1 0", "N")
            spec.assert_str_eq(said("SAY DATATYPE('x.1!?_', 'S') DATATYPE('a-b', 'S') DATATYPE('', 'S')"), "1 0 0", "S")
            spec.assert_str_eq(said("SAY DATATYPE('101', 'B') DATATYPE('1 0101', 'B') DATATYPE('10 1', 'B') DATATYPE('', 'B') DATATYPE('102', 'B') DATATYPE(' 1', 'B')"), "1 1 0 1 0 0", "B")
            spec.assert_str_eq(said("SAY DATATYPE('1aF', 'X') DATATYPE('1 aF', 'X') DATATYPE('1 a', 'X') DATATYPE('', 'X') DATATYPE('g', 'X')"), "1 1 0 1 0", "X")
        }
        spec.it("rejects an unknown option and a wrong argument count") callback {
            spec.assert_true(string.starts_with(said("SAY DATATYPE('1', 'Q')"), "ERROR") != 0, "Q")
            spec.assert_true(string.starts_with(said("SAY DATATYPE('1', 'WORD')"), "ERROR") != 0, "a word that is not a type name")
            spec.assert_true(string.starts_with(said("SAY DATATYPE()"), "ERROR") != 0, "none")
        }
    }
    spec.describe(fw, "SYMBOL") {
        spec.it("tells set variables, constant symbols and non-symbols apart") callback {
            spec.assert_str_eq(said("x = 1\nSAY SYMBOL('x') SYMBOL('X') SYMBOL('nope') SYMBOL('12') SYMBOL('.5') SYMBOL('a b') SYMBOL('')"), "VAR LIT LIT LIT LIT BAD BAD", "classes")
        }
        spec.it("substitutes a compound's tail") callback {
            spec.assert_str_eq(said("i = 2\nx.2 = 'two'\nSAY SYMBOL('x.i') SYMBOL('x.3')"), "VAR LIT", "compound")
        }
    }
    spec.describe(fw, "AND, OR and IFS") {
        spec.it("count text as true only when it reads true, as RexxJS does") callback {
            // AND and OR are also infix operators: a call after another term needs its own clause.
            spec.assert_str_eq(said("SAY AND(1, 'True')\nSAY AND(1, 0)\nSAY AND('yes')\nSAY OR('false', 0)\nSAY OR(JSON_PARSE('[]'))"), "true false false false true", "logic")
        }
        spec.it("pick IFS's first true test by JavaScript truthiness") callback {
            spec.assert_str_eq(said("SAY IFS('', 'a', 'false', 'b')\nSAY IFS(0, 'a', JSON_PARSE('null'), 'b', 'c')"), "b c", "ifs")
            spec.assert_str_eq(said("LET v = IFS(1, JSON_PARSE('[1, 2]'))\nSAY TYPEOF(v) ARRAY_LENGTH(v)"), "object 2", "a typed value passes through")
        }
    }
    spec.describe(fw, "EXIT UNLESS and TRACE") {
        spec.it("says the message and exits with the code only when the condition is false") callback {
            spec.assert_str_eq(said("x = 5\nEXIT UNLESS x > 9, 'x is' x\nSAY 'no'"), "x is 5", "an expression message, code 0")
            spec.assert_str_eq(said("EXIT UNLESS 1, 'no'\nSAY 'yes'"), "yes", "true goes on")
            spec.assert_str_eq(said("DO i = 1 TO 3\nEXIT UNLESS i < 2, 'stop at' i\nSAY i\nEND"), "1 stop at 2", "inside a loop")
        }
        spec.it("rejects a malformed EXIT UNLESS") callback {
            spec.assert_true(string.starts_with(said("EXIT UNLESS 1 'no comma'"), "ERROR") != 0, "no comma")
            spec.assert_true(string.starts_with(said("EXIT x UNLESS 1, 'm'"), "ERROR") != 0, "a code that is not a number")
        }
        spec.it("accepts TRACE options and rejects unknown ones") callback {
            spec.assert_str_eq(said("TRACE ?R\nTRACE 'n'\nTRACE NORMAL\nTRACE\nSAY 'ok'"), "ok", "accepted")
            spec.assert_true(string.starts_with(said("TRACE Q"), "ERROR") != 0, "Q")
            spec.assert_str_eq(said("trace = 1\nSAY trace"), "1", "trace = 1 assigns")
        }
    }
    spec.describe(fw, "array functions") {
        spec.it("pop, shift, reverse, slice and concat without changing their input") callback {
            spec.assert_str_eq(said("LET a = JSON_PARSE('[3,1,2,4]')\nLET p = ARRAY_POP(a)\nLET s = ARRAY_SHIFT(a)\nLET r = ARRAY_REVERSE(a)\nSAY p s JSON_STRINGIFY(r) JSON_STRINGIFY(a)"), "4 3 [4,2,1,3] [3,1,2,4]", "copies")
            spec.assert_str_eq(said("LET a = JSON_PARSE('[1,2,3,4,5]')\nLET x = ARRAY_SLICE(a, 1, 3)\nLET y = ARRAY_SLICE(a, -2)\nLET z = ARRAY_SLICE(a, 3, 1)\nLET w = ARRAY_SLICE(a, -9, 99)\nSAY JSON_STRINGIFY(x) JSON_STRINGIFY(y) JSON_STRINGIFY(z) JSON_STRINGIFY(w)"), "[2,3] [4,5] [] [1,2,3,4,5]", "slice bounds")
            spec.assert_str_eq(said("LET e = ARRAY_POP('[]')\nSAY '[' || e || ']'"), "[]", "empty pop")
        }
        spec.it("find items by type and value, and never a container") callback {
            spec.assert_str_eq(said("LET a = JSON_PARSE('[1,\"1\",[1],null]')\nLET n = ARRAY_INDEXOF(a, 1)\nLET t = ARRAY_INDEXOF(a, '1')\nLET c = ARRAY_INCLUDES(a, JSON_PARSE('[1]'))\nLET z = ARRAY_INDEXOF(a, JSON_PARSE('null'))\nSAY n t c z"), "0 1 false 3", "same value")
        }
        spec.it("sum, average and bound the numbers, dropping what is not one") callback {
            spec.assert_str_eq(said("LET a = JSON_PARSE('[1,\"2\",\"x\",true,null,\" \"]')\nSAY ARRAY_SUM(a) ARRAY_MIN(a) ARRAY_MAX(a) ARRAY_AVERAGE(a)"), "4 0 2 0.8", "Number() of each")
        }
        spec.it("keeps the first of each value in one pass over many items") callback {
            spec.assert_str_eq(said("s = '['\nDO i = 1 TO 3000\ns = s || (i % 7) || ','\nEND\nLET a = JSON_PARSE(s || '0]')\nLET u = ARRAY_UNIQUE(a)\nSAY ARRAY_LENGTH(a) ARRAY_LENGTH(u)"), "3001 7", "3001 items, 7 values")
        }
        spec.it("refuse what is not an array") callback {
            spec.assert_true(string.starts_with(said("SAY ARRAY_SUM('nope')"), "ERROR") != 0, "text")
            spec.assert_true(string.starts_with(said("SAY ARRAY_POP(JSON_PARSE('{}'))"), "ERROR") != 0, "object")
        }
    }
    spec.describe(fw, "JSON documents, URLs and Base64") {
        spec.it("SET and DELETE return new JSON text and leave their input alone") callback {
            spec.assert_str_eq(said("LET o = JSON_PARSE('{\"a\":[1,{\"b\":2}]}')\nLET r = JSON_SET(o, 'a.1.b', 3)\nLET d = JSON_DELETE(o, 'a.0')\nLET p = JSON_SET(o, 'a.2', 'end')\nSAY r d p JSON_STRINGIFY(o)"), "{\"a\":[1,{\"b\":3}]} {\"a\":[{\"b\":2}]} {\"a\":[1,{\"b\":2},\"end\"]} {\"a\":[1,{\"b\":2}]}", "paths through arrays")
            spec.assert_str_eq(said("LET r = JSON_SET('{\"a\":5}', 'a.b', 1)\nSAY r"), "{\"a\":{\"b\":1}}", "a scalar step becomes an object")
            spec.assert_str_eq(said("LET r = JSON_SET('not json', 'a', 1)\nLET h = JSON_HAS('not json', 'a')\nSAY r h"), "not json false", "text that is not JSON")
            spec.assert_true(string.starts_with(said("SAY JSON_SET('[1]', '5', 1)"), "ERROR") != 0, "past the end of an array")
        }
        spec.it("MERGE keeps the first object's order and returns it when either is not an object") callback {
            spec.assert_str_eq(said("LET m = JSON_MERGE('{\"b\":1,\"a\":2}', '{\"a\":3}')\nLET n = JSON_MERGE('[1]', '{\"a\":3}')\nSAY m n"), "{\"b\":1,\"a\":3} [1]", "merge")
        }
        spec.it("encode and decode URLs and Base64 over UTF-8 bytes") callback {
            spec.assert_str_eq(said("LET u = URL_ENCODE('é ✓')\nLET d = URL_DECODE(u)\nSAY u d"), "%C3%A9%20%E2%9C%93 é ✓", "UTF-8")
            spec.assert_str_eq(said("LET a = URL_DECODE('%ZZ')\nLET b = URL_DECODE('%C3')\nLET c = URL_DECODE('%')\nSAY '[' || a || b || c || ']'"), "[]", "malformed")
            spec.assert_str_eq(said("LET e = BASE64_ENCODE('a')\nLET f = BASE64_ENCODE('abc')\nLET g = BASE64_ENCODE('')\nSAY e f '[' || g || ']' BASE64_DECODE('YQ==') BASE64_DECODE('YW Jj') BASE64_DECODE('Pj4_')"), "YQ== YWJj [] a abc >>?", "padding, blanks, base64url")
            spec.assert_true(string.starts_with(said("SAY BASE64_DECODE('a$b')"), "ERROR") != 0, "bad character")
            spec.assert_true(string.starts_with(said("SAY BASE64_DECODE('abcde')"), "ERROR") != 0, "a lone sixth group")
        }
    }
    spec.describe(fw, "the external data queue") {
        spec.it("PUSH is last in first out, QUEUE first in first out") callback {
            spec.assert_str_eq(said("QUEUE 'a'\nQUEUE 'b'\nPUSH 'c'\nPUSH 'd'\nPARSE PULL w\nPARSE PULL x\nPARSE PULL y\nPARSE PULL z\nSAY w x y z"), "d c a b", "order")
        }
        spec.it("PULL uppercases and parses; PARSE PULL keeps the case; PARSE LOWER PULL lowers it") callback {
            spec.assert_str_eq(said("QUEUE 'Hello big World'\nPULL a b\nSAY a '|' b"), "HELLO | BIG WORLD", "PULL")
            spec.assert_str_eq(said("QUEUE 'Hello big World'\nPARSE PULL a . c\nSAY a c"), "Hello World", "PARSE PULL")
            spec.assert_str_eq(said("QUEUE 'Hello World'\nPARSE LOWER PULL a\nSAY a"), "hello world", "PARSE LOWER PULL")
            spec.assert_str_eq(said("s = 'MiXed'\nPARSE UPPER VAR s u\nPARSE LOWER VALUE s WITH l\nSAY u l"), "MIXED mixed", "PARSE UPPER VAR, LOWER VALUE")
        }
        spec.it("a bare PULL drops the top line; PUSH with nothing pushes an empty line") callback {
            spec.assert_str_eq(said("QUEUE 'one'\nQUEUE 'two'\nPULL\nPULL x\nPUSH\nLET n = STACK_SIZE()\nSAY x n"), "TWO 1", "bare forms")
        }
        spec.it("is one queue for the whole context, shared by PROCEDURE routines") callback {
            spec.assert_str_eq(said("CALL fill\nPULL a\nSAY a\nEXIT\nfill: PROCEDURE\nQUEUE 'from routine'\nRETURN"), "FROM ROUTINE", "shared")
        }
        spec.it("takes ten thousand lines at the bottom and gives them back in order") callback {
            spec.assert_str_eq(said("DO i = 1 TO 10000\nQUEUE i\nEND\nLET n = STACK_SIZE()\nPULL first\nDO 9998\nPULL x\nEND\nPULL last\nSAY n first last STACK_SIZE()"), "10000 1 10000 0", "bulk")
        }
        spec.it("is not an assignment target's keyword: push = 3 assigns") callback {
            spec.assert_str_eq(said("push = 3\nqueue = 4\npull = 5\nSAY push queue pull"), "3 4 5", "names")
        }
    }
    return spec.run_summary(fw)
}
