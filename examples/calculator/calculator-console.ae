// Real binary-library consumer. All effects belong to this host.
import rexxae
import std.io
import std.os
import std.string
import std.json
import examples.calculator.policy
import examples.calculator.service
import examples.calculator.consent
import examples.calculator.modules
import examples.calculator.downloaded
import std.map

dispatch(ctx: ptr, endpoint: string, ca: string, bindings: ptr) {
    name = string.copy(rexxae.rexxae_function(ctx))
    if name == "REQUIRE" {
        if endpoint == "" {
            rexxae.rexxae_reply_value(ctx, "null", "calculator module requires approved endpoint access")
            return
        }
        if rexxae.rexxae_argument_type(ctx, 0) != 3 {
            rexxae.rexxae_reply_value(ctx, "null", "module reference must be a string")
            return
        }
        reference = string.copy(rexxae.rexxae_argument_text(ctx, 0))
        if reference != "calculator" && reference != "/static/calculator.rexx" {
            rexxae.rexxae_reply_value(ctx, "null", "module unavailable; use /static/calculator.rexx")
            return
        }
        if reference == "/static/calculator.rexx" {
            if map.map_has(bindings, "_module_get") == 0 {
                rexxae.rexxae_reply_value(ctx, "null", "module GET capability was not approved")
                return
            }
            if map.map_has(bindings, "_module_source") == 0 {
                code, error = service.fetch(endpoint, ca, reference)
                if error == "" { error = downloaded.validate(code) }
                if error != "" { rexxae.rexxae_reply_value(ctx, "null", error); return }
                map.map_put_string_owned(bindings, "_module_source", code)
            }
        }
        args, _parse_error = json.parse(string.copy(rexxae.rexxae_arguments_json(ctx)))
        defer json.json_free(args)
        alias = ""
        if json.json_array_size(args) == 2 {
            if rexxae.rexxae_argument_type(ctx, 1) != 3 {
                rexxae.rexxae_reply_value(ctx, "null", "AS requires a string alias")
                return
            }
            alias = string.copy(rexxae.rexxae_argument_text(ctx, 1))
        }
        exported = string.to_upper(modules.function_name("CALC", alias))
        // Acknowledge the import to return to RUNNABLE, then bind its API
        // before resuming execution. Pending contexts cannot be registered.
        if rexxae.rexxae_reply_value(ctx, "true", "") == 0 {
            if rexxae.rexxae_register_function(ctx, exported, 3, 3) == 0 {
                map.map_put_string_owned(bindings, exported, reference)
            }
        }
        return
    }
    if endpoint == "" || map.map_has(bindings, name) == 0 {
        rexxae.rexxae_reply_value(ctx, "null", "calculator module not loaded")
        return
    }
    // Do not coerce objects, arrays, booleans or null into authority-bearing text.
    if rexxae.rexxae_argument_type(ctx, 0) != 3 || rexxae.rexxae_argument_type(ctx, 1) != 3 || rexxae.rexxae_argument_type(ctx, 2) != 3 {
        rexxae.rexxae_reply_value(ctx, "null", "CALC requires three strings: operation, left, right")
        return
    }
    if string.copy(map.map_get_raw(bindings, name)) == "/static/calculator.rexx" {
        code = string.copy(map.map_get_raw(bindings, "_module_source"))
        arguments = string.copy(rexxae.rexxae_arguments_json(ctx))
        result, error = downloaded.run(code, arguments, |request: ptr| {
            path = string.copy(map.map_get_raw(request, "path"))
            body = string.copy(map.map_get_raw(request, "body"))
            response, failure = service.post(endpoint, ca, path, body)
            map.map_put_string_owned(request, "response", response)
            map.map_put_string_owned(request, "error", failure)
        })
        if rexxae.rexxae_reply_value(ctx, result, error) != 0 { rexxae.rexxae_reply_value(ctx, "null", "module result is outside the JSON profile") }
        return
    }
    op = string.copy(rexxae.rexxae_argument_text(ctx, 0))
    a = string.copy(rexxae.rexxae_argument_text(ctx, 1))
    b = string.copy(rexxae.rexxae_argument_text(ctx, 2))
    value, err = service.call(endpoint, ca, op, a, b)
    encoded = json.str(value)
    defer json.json_free(encoded)
    text, _err = json.stringify(encoded)
    rexxae.rexxae_reply_value(ctx, text, err)
}

submit(previous: @keep ptr, source: string, endpoint: string, ca: string, bindings: ptr) -> ptr {
    next = rexxae.rexxae_create_next(previous, source)
    if next == null { io.stderr_write("cannot create submission\n"); return previous }
    if rexxae.rexxae_step(next, 0) == -1 {
        io.stderr_write("${string.copy(rexxae.rexxae_error(next))}\n")
        rexxae.rexxae_destroy(next)
        return previous
    }
    steps = 0
    while steps < 100000 {
        status = rexxae.rexxae_step(next, 1)
        if status == 0 || status == -1 {
            if status == -1 { io.stderr_write("${string.copy(rexxae.rexxae_error(next))}\n") }
            rexxae.rexxae_destroy(previous)
            return next
        }
        if status == 1 { println(string.copy(rexxae.rexxae_text(next))) }
        if status == 2 { rexxae.rexxae_reply(next, 13, "", "environment not mounted") }
        if status == 4 { dispatch(next, endpoint, ca, bindings) }
        steps = steps + 1
    }
    io.stderr_write("instruction limit reached; submission discarded\n")
    rexxae.rexxae_destroy(next)
    return previous
}

main() {
    endpoint = os.getenv("CALC_ENDPOINT")
    if endpoint == null { endpoint = "" }
    ca = os.getenv("CALC_CA")
    if ca == null { ca = "" }
    program = os.getenv("CALC_PROGRAM")
    source = ""
    module_approved = false
    if endpoint != "" {
        if program == null || program == "" { io.stderr_write("CALC_PROGRAM required to run the calculator script\n"); return 1 }
        if string.starts_with(endpoint, "https://") == 1 && ca == "" { io.stderr_write("CALC_CA required for HTTPS\n"); return 1 }
        text, err = io.read_file(program)
        if err != "" { io.stderr_write("cannot read CALC_PROGRAM\n"); return 1 }
        denial = policy.preflight(text, endpoint)
        if denial != "" { io.stderr_write("${denial}\n"); return 1 }
        preapproved = os.getenv("CALC_APPROVE_ENDPOINT")
        if preapproved == null { preapproved = "" }
        if !consent.approve(text, endpoint, program, preapproved) {
            io.stderr_write("required calculator capability denied; script was not executed\n")
            return 1
        }
        if policy.module_requested(text) {
            approved_module = os.getenv("CALC_APPROVE_MODULE_URL")
            if approved_module == null { approved_module = "" }
            if !consent.approve_module(text, endpoint, program, approved_module) {
                io.stderr_write("required module GET capability denied; script was not executed\n")
                return 1
            }
            module_approved = true
        }
        source = text
    } else {
        if program != null && program != "" { io.stderr_write("CALC_PROGRAM requires host-approved CALC_ENDPOINT\n"); return 1 }
    }
    if os.setenv("AETHER_PURE_TLS", "1") != "" { return 1 }
    ctx = rexxae.rexxae_create("")
    if ctx == null { return 1 }
    bindings = map.map_new()
    defer map.map_free(bindings)
    if module_approved { map.map_put_string_owned(bindings, "_module_get", "approved") }
    rexxae.rexxae_register_function(ctx, "REQUIRE", 1, 2)
    rexxae.rexxae_step(ctx, 1)
    if source != "" { ctx = submit(ctx, source, endpoint, ca, bindings) }
    // :quit exits; = expression is shorthand for SAY. Blank lines continue.
    // A partial final line is submitted once, even when eof is already true.
    while true {
        line, eof, err = io.fd_read_line_status(0)
        if err != "" { io.stderr_write("${err}\n"); rexxae.rexxae_destroy(ctx); return 1 }
        command = string.trim(line)
        if command == ":quit" { break }
        if command != "" {
            input = line
            if string.starts_with(command, "=") == 1 { input = "SAY ${string.substring(command, 1, string.length(command))}" }
            ctx = submit(ctx, input, endpoint, ca, bindings)
        }
        if eof { break }
    }
    rexxae.rexxae_destroy(ctx)
    return 0
}
