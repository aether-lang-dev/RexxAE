// rexxae-worker: runs one Rexx script for a host in another process.
//
// The host starts this program with std.guest (guest.launch, through
// sandbox.spawn_socket) and talks to it over the socket in frames. The
// protocol, and everything about it on this side (the mounts and the
// script, the lockdown, the PROBE self-check, CANCEL, LOGLEVEL, a file
// handed over as a descriptor), is Aether's std.guest.child; its README
// (std/guest/README.md) has every message. What is here is the engine glue:
// how a Rexx script runs, in steps, and what each step's event becomes.
// The engine is compiled in from source, so the worker is one binary:
// under the process sandbox it needs no grants at all.
//
// Three walls. The engine's own: it has no system API, every effect is an
// event this worker answers, and it mounts no ADDRESS environment. This
// worker's: child.run enters sandbox.enforce with no grants before the
// script's first step, so even a bug in the engine is held to nothing. And
// the process's, the sandbox the host spawned it in, which also holds code
// that goes round std and libc.
//
// It answers a CANCEL at any point after SCRIPT with rexxae_cancel: between
// steps of BUDGET instructions (child.poll) or instead of a reply to a call
// (child.call_host), so a script that loops forever or waits forever on the
// host stops within one step.

import std.guest.child
import std.string
import src.engine

// Instructions per step: how often a running script looks for a CANCEL.
const BUDGET = 1000

main() {
    h, err = child.open("rexxae-worker")
    if err != "" {
        println(err)
        exit(2)
    }
    // The mounts, PROBE, LOGLEVEL and the script; a protocol error has been
    // sent to the host as ERROR.
    if child.read_script(h) != "" { exit(1) }

    ctx = engine.rexxae_create(h.source)
    defer engine.rexxae_destroy(ctx)
    engine.rexxae_set_log_level(ctx, h.log_level)
    n = child.mount_count(h)
    i = 0
    while i < n {
        name, lo, hi = child.mount_at(h, i)
        if engine.rexxae_register_function(ctx, name, lo, hi) != 0 {
            child.error(h, "cannot mount ${name} (a builtin, or a bad arity)")
            exit(1)
        }
        i = i + 1
    }

    // From here on it grants itself nothing: no files, no network, no
    // processes, with no platform path anywhere.
    child.run(h) callback {
        run_script(ctx, h)
    }
    exit(0)
}

// The script, BUDGET instructions at a time, answering each event.
run_script(ctx: ptr, h: *child.Host) {
    level = h.log_level
    cancelled = 0
    while true {
        status = engine.rexxae_step(ctx, BUDGET)
        if status == 0 {
            child.done(h, engine.rexxae_exit_code(ctx))
            return
        }
        if status == -1 {
            child.error(h, string.copy(engine.rexxae_error(ctx)))
            return
        }
        if status == 1 {
            child.say(h, string.copy(engine.rexxae_text(ctx)))
        } else if status == 2 {
            // No ADDRESS environment is mounted: every command is vetoed.
            address = string.copy(engine.rexxae_address(ctx))
            child.audit(h, "rexxae-worker refused ADDRESS ${address}: no environment is mounted")
            engine.rexxae_reply(ctx, 1, "", "ADDRESS ${address} is not mounted")
        } else if status == 5 {
            tags = string.copy(engine.rexxae_log_tags_json(ctx))
            child.log(h, engine.rexxae_log_level(ctx), tags, string.copy(engine.rexxae_text(ctx)))
        } else if status == 4 {
            name = string.copy(engine.rexxae_function(ctx))
            r = child.call_host(h, name, string.copy(engine.rexxae_arguments_json(ctx)))
            if r.kind == "VALUE" {
                if engine.rexxae_reply_value(ctx, r.text, "") != 0 {
                    engine.rexxae_reply_value(ctx, "null", "the host's reply is not valid JSON")
                }
            } else if r.kind == "FAIL" {
                engine.rexxae_reply_value(ctx, "null", r.text)
            }
        }
        if status != 4 { child.poll(h) }
        if h.cancel != "" && cancelled == 0 {
            engine.rexxae_cancel(ctx, h.cancel)
            cancelled = 1
        }
        // A LOGLEVEL from the host: the engine's threshold from the next step.
        if h.log_level != level {
            level = h.log_level
            engine.rexxae_set_log_level(ctx, level)
        }
    }
}
